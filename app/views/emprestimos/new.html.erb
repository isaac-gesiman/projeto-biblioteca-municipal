<div class="faixada">
  <h1 class="itemFaixa h1faixa">Biblioteca Municipal de Mossoró</h1>

  <%= image_tag "prefeitura log.png",
      class: "itemFaixa logo-prefeitura" %>
</div>

<h2 class="titulo">Novo Empréstimo</h2>
<div class="PainelEmprestimoPai">
    <div class="PainelEmprestimo">
        <% if @emprestimo.errors.any? %>
        <div>
            <% @emprestimo.errors.full_messages.each do |mensagem| %>
            <p><%= mensagem %></p>
            <% end %>
        </div>
        <% end %>

        <%= form_with model: @emprestimo do |form| %>

            <div>
                <%= form.label :usuario_id, "Usuário", class:"itemEmprestimo" %>
                <%= form.collection_select :usuario_id, @usuarios, :id, :nome, {}, class:"preencherUE" %>
            </div>

            <div>
                <%= form.label :livro_id, "Livro", class:"itemEmprestimo" %>
                <%= form.collection_select :livro_id, @livros, :id, :titulo, {}, class:"preencherLE" %>
            </div>

            <div>
                <%= form.label :bibliotecario_id, "Bibliotecário", class:"itemEmprestimo"%>
                <%= form.collection_select :bibliotecario_id, @bibliotecarios, :id, :nome, {}, class:"preencherBE" %>
            </div>

            <div>
                <%= label_tag :senha_emprestimo, "Senha de empréstimo", class:"itemEmprestimo" %>
                <%= password_field_tag :senha_emprestimo, nil, required: true, class:"preencherSE" %>
            </div>
                
            <div>
                <%= form.submit "Confirmar empréstimo", class:"botaoEmprestimo" %>
            </div>
    </div>
</div>

<% end %>