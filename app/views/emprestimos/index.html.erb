<div class="faixada">
  <h1 class="itemFaixa h1faixa">Biblioteca Municipal de Mossoró</h1>

  <%= image_tag "prefeitura log.png",
      class: "itemFaixa logo-prefeitura" %>
</div>

<h2 class="titulo">Empréstimos Ativos</h2>

<% if @emprestimos.any? %>
  <% @emprestimos.each do |emprestimo| %>
    <div>
      <p><strong>Usuário:</strong> <%= emprestimo.usuario.nome %></p>
      <p><strong>Livro:</strong> <%= emprestimo.livro.titulo %></p>
      <p><strong>Bibliotecário:</strong> <%= emprestimo.bibliotecario.nome %></p>
      <p><strong>Data do empréstimo:</strong> <%= emprestimo.data_emprestimo.to_date %></p>
      <p><strong>Devolução prevista:</strong> <%= emprestimo.data_prevista_devolucao %></p>

      <%= button_to "Devolver",
          devolver_emprestimo_path(emprestimo),
          method: :patch %>

      <hr>
    </div>
  <% end %>
<% else %>
  <p>Nenhum empréstimo ativo.</p>
<% end %>