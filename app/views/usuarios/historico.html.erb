<div class="faixada">
  <h1 class="itemFaixa h1faixa">
    Biblioteca Municipal de Mossoró
  </h1>

  <%= image_tag "prefeitura log.png",
      class: "itemFaixa logo-prefeitura" %>
</div>

<h2 class="titulo">Histórico de Empréstimos</h2>

<div class="painelLogin">

  <% if @emprestimos.any? %>

    <% @emprestimos.each do |emprestimo| %>

      <div>

        <p>
          <strong>Livro:</strong>
          <%= emprestimo.livro.titulo %>
        </p>

        <p>
          <strong>Data do empréstimo:</strong>
          <%= emprestimo.data_emprestimo.to_date %>
        </p>

        <p>
          <strong>Devolução prevista:</strong>
          <%= emprestimo.data_prevista_devolucao %>
        </p>

        <p>
          <strong>Data da devolução:</strong>
          <%= emprestimo.data_devolucao.to_date %>
        </p>

        <p>
          <strong>Status:</strong>
          <%= emprestimo.status %>
        </p>


        <% if emprestimo.atrasado? %>

          <div class="multaAtraso">

            <p>
              <strong>Atraso:</strong>
              <%= emprestimo.dias_atraso %>
              <%= emprestimo.dias_atraso == 1 ? "dia" : "dias" %>
            </p>

            <p>
              <strong>Multa:</strong>
              <%= number_to_currency(
                    emprestimo.multa,
                    unit: "R$ ",
                    separator: ",",
                    delimiter: "."
                  ) %>
            </p>

          </div>

        <% else %>

          <p class="semMulta">
            <strong>Multa:</strong> R$ 0,00
          </p>

        <% end %>


        <% if emprestimo.renovacoes.to_i > 0 %>
          <p>
            <strong>Renovação:</strong>
            realizada
          </p>
        <% end %>

        <hr>

      </div>

    <% end %>

  <% else %>

    <p>Você ainda não possui empréstimos finalizados.</p>

  <% end %>

</div>


<%= link_to "Voltar",
    painel_usuario_path,
    class: "botao-home" %>