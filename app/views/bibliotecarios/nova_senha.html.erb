<div class="faixada">
  <h1 class="itemFaixa h1faixa">Biblioteca Municipal de Mossoró</h1>

  <%= image_tag "prefeitura log.png",
      class: "itemFaixa logo-prefeitura" %>
</div>

<h2 class="titulo">Criar nova senha</h2>

<% if @bibliotecario.errors.any? %>
  <div>
    <% @bibliotecario.errors.full_messages.each do |mensagem| %>
      <p><%= mensagem %></p>
    <% end %>
  </div>
<% end %>

<%= form_with url: nova_senha_path, method: :patch do |form| %>

  <div>
    <%= form.label :password, "Nova senha" %>
    <%= form.password_field :password, required: true %>
  </div>

  <div>
    <%= form.label :password_confirmation, "Confirmar nova senha" %>
    <%= form.password_field :password_confirmation, required: true %>
  </div>

  <div>
    <%= form.submit "Salvar nova senha" %>
  </div>

<% end %>